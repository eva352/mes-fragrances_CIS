{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-stack.local/schema/app-spec.schema.json",
  "title": "Aurora App Spec",
  "type": "object",
  "required": ["version", "kind", "project", "shell", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "kind": { "type": "string", "const": "aurora.app" },
    "project": {
      "type": "object",
      "required": ["id", "title", "theme"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "theme": {
          "type": "object",
          "required": ["mode", "palette"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["system", "light", "dark"] },
            "palette": { "type": "string" }
          }
        }
      }
    },
    "shell": {
      "type": "object",
      "required": ["layout", "navigation"],
      "additionalProperties": false,
      "properties": {
        "layout": { "type": "string", "enum": ["sidebar"] },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "path", "title", "sections"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "title": { "type": "string" },
        "enabled": { "type": "boolean" },
        "templateId": { "type": ["string", "null"] },
        "objective": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "successCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/customBlock" }
        },
        "dataSources": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataSource" }
        }
      }
    },
    "customBlock": {
      "type": "object",
      "required": ["id", "type", "title", "layout", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "const": "custom" },
        "title": { "type": "string" },
        "layout": { "$ref": "#/$defs/layout" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["kind", "options"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["stack", "split", "grid", "tabs"] },
        "options": { "type": "object" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "componentKey", "props"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "componentKey": { "type": "string" },
        "props": { "type": "object" },
        "bindings": { "type": "object" }
      }
    },
    "dataSource": {
      "type": "object",
      "required": ["id", "kind", "endpoint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["http"] },
        "endpoint": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}

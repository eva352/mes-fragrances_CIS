# Bind host for exposed ports (security)
# - local dev: keep 127.0.0.1
# - server: keep 127.0.0.1 + SSH tunnel, OR set 0.0.0.0 behind a firewall/reverse-proxy
PILOT_BIND_HOST=127.0.0.1
PILOT_FRONTEND_BIND_HOST=127.0.0.1
PILOT_PUBLIC_DOMAIN=example.com
PILOT_PUBLIC_WWW_DOMAIN=www.example.com

# Ports (change if already used)
PILOT_FRONTEND_PORT=19100
PILOT_BACKEND_PORT=19101
PILOT_DB_PORT=19432

# Option avancée : utiliser un Postgres externe (au lieu du conteneur Docker fourni).
# Exemple :
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# (Tu peux ajouter `?sslmode=require` si nécessaire.)
# DATABASE_URL=

# Postgres (included via docker compose)
PILOT_DB_NAME=pilot
PILOT_DB_USER=pilot
PILOT_DB_PASSWORD=change_me

# Initial admin user (created during migrations)
# Nom du projet affiché dans l’interface (UI). Ce n’est pas le nom de la stack.
PILOT_PROJECT_TITLE=Pilot

PILOT_ADMIN_EMAIL=admin@example.com
PILOT_ADMIN_PASSWORD=change_me

# Backend (CORS)
PILOT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19100,https://pilot.auroramind.fr,https://example.com,https://www.example.com

# Auth (JWT)
# Must be a strong random value (>= 32 chars). The setup scripts will generate it for you.
PILOT_JWT_SECRET_KEY=change_me
PILOT_JWT_ALGORITHM=HS256
PILOT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server-side encryption (OpenRouter BYOK storage)
# Must be a 32-byte urlsafe base64 key (Fernet-compatible).
# The setup scripts will generate it for you.
PILOT_ENCRYPTION_KEY=change_me

# Optional (debug/enterprise): override OpenRouter base URL
# PILOT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Frontend -> API base URL (public; gets embedded in the frontend build)
# Recommended (same-origin): keep `/api/v1` (works with Next rewrites + reverse-proxy like Caddy).
NEXT_PUBLIC_PILOT_BACKEND_URL=/api/v1

# Nom affiché côté frontend (UI). Recommandé : même valeur que PILOT_PROJECT_TITLE.
NEXT_PUBLIC_PILOT_APP_NAME=Pilot
# Optional (direct backend, bypass proxy): http://127.0.0.1:${PILOT_BACKEND_PORT}/api/v1
# Prod behind Caddy reverse-proxy:
# NEXT_PUBLIC_PILOT_BACKEND_URL=https://pilot.auroramind.fr/api/v1

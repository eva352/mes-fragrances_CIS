{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-stack.local/schema/site-spec.schema.json",
  "title": "Aurora Site Spec",
  "type": "object",
  "required": ["version", "kind", "project", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "kind": { "type": "string", "const": "aurora.site" },
    "project": {
      "type": "object",
      "required": ["id", "title", "theme"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "theme": {
          "type": "object",
          "required": ["mode", "palette"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["system", "light", "dark"] },
            "palette": { "type": "string" }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["slug", "title", "path", "blocks"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/registryBlock" },
        { "$ref": "#/$defs/customBlock" }
      ]
    },
    "registryBlock": {
      "type": "object",
      "required": ["id", "type", "category", "slug", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "const": "registry" },
        "category": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "customBlock": {
      "type": "object",
      "required": ["id", "type", "title", "layout", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "const": "custom" },
        "title": { "type": "string" },
        "layout": { "$ref": "#/$defs/layout" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["kind", "options"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["stack", "split", "grid", "tabs"] },
        "options": { "type": "object" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "componentKey", "props"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "componentKey": { "type": "string" },
        "props": { "type": "object" },
        "bindings": { "type": "object" }
      }
    }
  }
}

